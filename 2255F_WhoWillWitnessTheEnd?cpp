#include <bits/stdc++.h>
using namespace std;
using ll = long long;

const int MOD = 998244353;

// Fast exponentiation
ll modpow(ll a, ll e) {
    ll r = 1;
    while (e) {
        if (e & 1) r = r * a % MOD;
        a = a * a % MOD;
        e >>= 1;
    }
    return r;
}

// Modular inverse
ll modinv(ll a) {
    return modpow(a, MOD - 2);
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<ll> a(n);
        for (int i = 0; i < n; i++) cin >> a[i];

        // Compute sum of squares and sum of elements
        ll sum = 0, sqsum = 0;
        for (ll x : a) {
            sum = (sum + x) % MOD;
            sqsum = (sqsum + x * x) % MOD;
        }

        // Burnside’s Lemma
        ll ans = 0;
        for (int k = 0; k < n; k++) {
            int g = gcd(n, k);
            // Contribution: (sum^g + (sqsum - sum^2))^(n/g)
            // Simplifies to (sum^g + (sqsum - sum))^(n/g)
            ll contrib = modpow(sum, g);
            ans = (ans + contrib) % MOD;
        }

        ans = ans * modinv(n) % MOD;
        cout << ans << "\n";
    }
    return 0;
}
